from __future__ import annotations

import asyncio
import contextlib
from typing import Any, Literal, Mapping, Optional, Sequence, overload

from .dialects.base import Dialect
from .dialects.placeholders import render_for_driver
from .middleware.base import Middleware, ExecutionContext, MiddlewareChain

ConnectionName = str # IE: 'read', 'write', 'analytics', 'admin', etc.
Action = Literal["select", "insert", "update", "delete", "other"]

class Connection:
    """
    A connection to a database.
    """

    name: ConnectionName
    dialect: Dialect
    connection: Any
    type: Literal["read", "write", "both"] = "both"

class Sorcerer:
    """
    Pulic facade that owns:
    - Dialect (paramstyle, vendor features, etc)
    - Named connections and active swapping
    - Middleware pipeline
    - Single execution path for all SQL

    You Supply real connection/pool handling by overriding '_open_handle' and '_run_on_handle'.
    For many apps you'll wire specific drivers (aiomysql/psycopq/asyncpg/sqlite3) in a sublcass
    or via simple adapters.
    """

    def __int__(
        self,
        *,
        default_dsn: ConnectionName,
        connections: dict[ConnectionName, Connection],
        middleware: Sequence[Middleware] = ()
    ) -> None:

        self._default_dsn = default_dsn
        self._dialect     = connections[default_dsn].dialect
        self._conns       = connections
        self._mw          = MiddlewareChain(middleware)
        self._active      = connections[default_dsn].connection

        # Lazy Open Handles ---- Key by connection name or "__default__"
        self._handles: dict[str, Any] = {}
        self._lock = asyncio.Lock()

    def __enter__(self) -> Sorcerer:
        return self

    def __exit__(self, exc_type: Any, exc_value: Any, traceback: Any) -> None:
        self.close()

    # ----- Public properties -------------------------------------------------
    @property
    def dialect(self) -> Dialect:
        return self._dialect

    @property
    def active_connection(self) -> Optional[Any]:
        return self._active

    # ----- Named connections -------------------------------------------------
    def bind_conn(self, name: ConnectionName, dsn: dict[ConnectionName, Connection]) -> "Sorcerer":
        """Register or replace a named connection"""
        
        self._conns[name] = dsn.get(name)
        return self

    def use_conn(self, name: ConnectionName) -> "Sorcerer":
        """Activate a named connection"""
        if name not in self._conns:
            raise ValueError(f"Unknown connection: {name}")
        
        self._active = self._conns[name].connection
        return self

    # def get_conn(self, name: ConnectionName) -> Connection:

    def set_conn_by_type(self, type: Literal["read", "write", "both"]) -> "Sorcerer":
        """Set a connection by type"""
        if type not in ("read", "write", "both"):
            raise ValueError(f"Invalid connection type: {type}")

        for conn in self._conns.values():
            if conn.type == type:
                self._active = conn.connection
                return self

        raise ValueError(f"No connection found for type: {type}")

    # def _open_handle(self, dsn: str | None = None) -> Any:
    #     """
    #     Open a connection to the database.
    #     """

    # ----- Execution routing -------------------------------------------------
    @overload
    async def execute(
        self,
        sql: str,
        params: Mapping[str, Any] | Sequence[Any] | None = ...,
        /,
        *,
        action: Action = "other",
        table: Optional[str] = ...,
        where: str | None = ...,
        payload: Any = ...,
        columns: Sequence[str] | None = ...,
        conn: ConnectionName | None = ...,
        timeout: float | None = ...,
    ) -> Any: ...

    

class SorcererClient:
    """Very small client wrapper to show where middleware and dialect slot in.

    This expects a synchronous PEP-249 connection. Async support can be added 
    later via a parallel AsyncSorcererClient.
    """

    def __init__(self, 
        connection_factory: Callable[..., Any], 
        middlewares: Optional[Iterable[Middleware]] = None) -> None:

        self._connection_factory = connection_factory
        self.middleware = MiddlewareChain(middlewares)
        self._conn: Any | None = None

    def connect(self, dsn: str | None = None) -> Any | None:
        self.middleware.before_connect(dsn=dsn)
        self._conn = self._connection_factory(dsn)
        self.middleware.after_connect(conn=self._conn)
        return self._conn

    def close(self) -> None:
        if self._conn is None:
            return None
        
        self.middleware.before_close(conn=self._conn)
        self._conn.close()
        self.middleware.after_close()
        self._conn = None

    def execute(self, sql: str, params: Any = None):
        if self._conn is None:
            self.connect()

        ctx = ExecutionContext(operation="execute", sql=sql, params=params)
        self.middleware.before_execute(ctx)

        try:
            if self._conn is None:
                raise ValueError("Connection is None")

            cur = self._conn.cursor()
            cur.execute(sql, params)
            ctx.cursor = cur
            ctx.mark_finish()
            ctx.rowcount = getattr(cur, "rowcount", None)
            self.middleware.after_execute(ctx, cur)
            return cur
        except BaseException as exc:
            ctx.exception = exc
            ctx.mark_finish()
            self.middleware.on_execute_error(ctx, exc)
            raise

    def executemany(self, sql: str, seq_of_params: Sequence[Sequence[Any]]):
        if self._conn is None:
            return None

        ctx = ExecutionContext(operation="executemany", sql=sql, params=tuple(seq_of_params))
        self.middleware.before_execute(ctx)

        try:
            if self._conn is None:
                raise ValueError("Connection is None")

            cur = self._conn.cursor()
            cur.executemany(sql, seq_of_params)
            ctx.cursor = cur
            ctx.mark_finish()
            ctx.rowcount = getattr(cur, "rowcount", None)
            self.middleware.after_execute(ctx, cur)
            return cur
        except BaseException as exc:
            ctx.exception = exc
            ctx.mark_finish()
            self.middleware.on_execute_error(ctx, exc)
            raise

    def commit(self):
        if self._conn is None:
            return None

        self.middleware.before_commit(conn=self._conn)
        self._conn.commit()
        self.middleware.after_commit()

    def rollback(self):
        if self._conn is None:
            return None

        self.middleware.before_rollback(conn=self._conn)
        self._conn.rollback()
        self.middleware.after_rollback()

